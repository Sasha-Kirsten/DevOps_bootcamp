pipeline {
  agent any

  parameters {
    booleanParam(
      name: 'APPLY_CHANGES',
      defaultValue: false,
      description: 'Apply Ansible changes after validation. Leave false for a safe validation-only run.'
    )
  }

  environment {
    REMOTE_WORKDIR = '/home/ec2-user/jenkins-ansible-demo'
  }

  stages {
    stage('Validate repository files') {
      steps {
        sh '''
          ansible-galaxy collection install -r requirements.yml
          ansible-playbook --syntax-check -i 'localhost,' -c local deploy-docker-new-user.yaml
        '''
      }
    }

    stage('Copy files to Ansible control node') {
      steps {
        sshagent(credentials: ['ansible-server-key']) {
          sh '''
            test -n "$ANSIBLE_SERVER_PUBLIC_IP"
            ssh "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP" "mkdir -p '$REMOTE_WORKDIR'"
            scp ansible.cfg inventory_aws_ec2.yaml deploy-docker-new-user.yaml requirements.yml "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP:$REMOTE_WORKDIR/"
            scp -r group_vars "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP:$REMOTE_WORKDIR/"
          '''
        }
      }
    }

    stage('Discover intended EC2 targets') {
      steps {
        sshagent(credentials: ['ansible-server-key']) {
          sh '''
            ssh "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP" "cd '$REMOTE_WORKDIR' && ansible-galaxy collection install -r requirements.yml && ansible-inventory --graph"
          '''
        }
      }
    }

    stage('Configure development Docker hosts') {
      when {
        expression { params.APPLY_CHANGES }
      }
      steps {
        sshagent(credentials: ['ansible-server-key']) {
          withCredentials([sshUserPrivateKey(credentialsId: 'ec2-server-key', keyFileVariable: 'MANAGED_NODE_KEY')]) {
            sh '''
              test -n "$ANSIBLE_SERVER_PUBLIC_IP"
              scp "$MANAGED_NODE_KEY" "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP:$REMOTE_WORKDIR/managed-node-key.pem"
              ssh "ec2-user@$ANSIBLE_SERVER_PUBLIC_IP" "chmod 600 '$REMOTE_WORKDIR/managed-node-key.pem' && cd '$REMOTE_WORKDIR' && ansible-playbook --private-key '$REMOTE_WORKDIR/managed-node-key.pem' deploy-docker-new-user.yaml"
            '''
          }
        }
      }
    }
  }

  post {
    always {
      echo 'Validation and inventory output are available in the Jenkins build log.'
    }
  }
}