{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Microservice chart values",
  "type": "object",
  "required": ["appName", "appImage", "appVersion", "appReplicas", "containerPort", "service"],
  "properties": {
    "appName": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "appImage": {"type": "string", "minLength": 1, "description": "Repository path only. This chart currently renders image:tag, not digest references."},
    "appVersion": {"type": "string", "minLength": 1},
    "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
    "appReplicas": {"type": "integer", "minimum": 1},
    "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
    "containerEnvVars": {"type": "array", "description": "Non-sensitive literal environment variables only; use a Secret-based extension for credentials.", "items": {"type": "object", "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["string", "number", "boolean"]}}}},
    "service": {"type": "object", "required": ["type", "port", "targetPort"], "properties": {"type": {"type": "string", "enum": ["ClusterIP", "LoadBalancer", "NodePort"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "probes": {"type": "object", "description": "HTTP probe settings. Disable for non-HTTP workloads until the chart is extended with another probe type.", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "path": {"type": "string"}, "initialDelaySeconds": {"type": "integer", "minimum": 0}, "periodSeconds": {"type": "integer", "minimum": 1}}},
    "ingress": {"type": "object", "description": "Ingress is disabled by default. Production use requires controller-specific annotations and TLS support.", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string"}, "host": {"type": "string"}, "path": {"type": "string"}}},
    "testConnection": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}
  }
}