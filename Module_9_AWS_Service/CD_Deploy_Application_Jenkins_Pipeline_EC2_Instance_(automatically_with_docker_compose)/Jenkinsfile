pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'IMAGE_REPOSITORY', defaultValue: '', description: 'Registry repository, for example docker.io/your-user/myapp.')
        string(name: 'EC2_HOST', defaultValue: '', description: 'Target in user@host form, for example ubuntu@ec2-203-0-113-10.compute-1.amazonaws.com.')
        booleanParam(name: 'PUBLISH_IMAGE', defaultValue: false, description: 'Push the tested immutable image to the container registry.')
        booleanParam(name: 'DEPLOY_TO_EC2', defaultValue: false, description: 'Require approval and deploy the newly published image through Docker Compose.')
    }

    environment {
        APPLICATION_DIRECTORY = 'myapp'
        REMOTE_COMPOSE_FILE = 'docker-compose.yaml'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                dir(env.APPLICATION_DIRECTORY) {
                    sh 'mvn --batch-mode clean verify'
                }
            }
        }

        stage('Build Image') {
            steps {
                script {
                    env.IMAGE_TAG = "1.0.${env.BUILD_NUMBER}"
                    env.LOCAL_IMAGE = "myapp:${env.IMAGE_TAG}"
                }
                sh 'docker build --tag "$LOCAL_IMAGE" .'
            }
        }

        stage('Publish Image') {
            when {
                expression { return params.PUBLISH_IMAGE || params.DEPLOY_TO_EC2 }
            }
            steps {
                script {
                    if (!params.IMAGE_REPOSITORY.trim()) {
                        error('IMAGE_REPOSITORY is required when publishing or deploying.')
                    }
                    env.PUBLISHED_IMAGE = "${params.IMAGE_REPOSITORY}:${env.IMAGE_TAG}"
                }
                withCredentials([usernamePassword(credentialsId: 'container-registry-credentials', usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh '''
                        registry_host="${IMAGE_REPOSITORY%%/*}"
                        printf '%s' "$REGISTRY_PASSWORD" | docker login "$registry_host" --username "$REGISTRY_USERNAME" --password-stdin
                        docker image tag "$LOCAL_IMAGE" "$PUBLISHED_IMAGE"
                        docker image push "$PUBLISHED_IMAGE"
                        docker logout "$registry_host"
                    '''
                }
            }
        }

        stage('Approval') {
            when {
                expression { return params.DEPLOY_TO_EC2 }
            }
            steps {
                script {
                    if (!params.EC2_HOST.trim()) {
                        error('EC2_HOST is required when deploying.')
                    }
                }
                input message: 'Review the published immutable image. Deploy it to EC2?', ok: 'Deploy'
            }
        }

        stage('Deploy with Docker Compose') {
            when {
                expression { return params.DEPLOY_TO_EC2 }
            }
            steps {
                sshagent(credentials: ['ec2-ssh-key']) {
                    sh '''
                        mkdir -p "$HOME/.ssh"
                        ec2_host_name="${EC2_HOST#*@}"
                        ssh-keyscan -H "$ec2_host_name" >> "$HOME/.ssh/known_hosts"
                        scp "$REMOTE_COMPOSE_FILE" "$EC2_HOST:/home/${EC2_HOST%@*}/docker-compose.yaml"
                        ssh "$EC2_HOST" "
                          APP_IMAGE='$PUBLISHED_IMAGE' docker compose -f docker-compose.yaml pull &&
                          APP_IMAGE='$PUBLISHED_IMAGE' docker compose -f docker-compose.yaml up --detach --force-recreate --remove-orphans &&
                          curl --fail --silent --show-error http://localhost:8090/health
                        "
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'myapp/target/*.jar', allowEmptyArchive: true
        }
    }
}