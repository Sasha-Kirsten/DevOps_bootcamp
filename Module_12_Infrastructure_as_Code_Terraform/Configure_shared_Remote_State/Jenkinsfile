pipeline {
    agent any

    parameters {
        string(name: 'STATE_BUCKET', defaultValue: '', description: 'Existing S3 state bucket name created by bootstrap/.')
        string(name: 'STATE_KEY', defaultValue: 'environments/development/terraform.tfstate', description: 'Object key for this environment state.')
        booleanParam(name: 'RUN_PLAN', defaultValue: false, description: 'Run an AWS-authenticated Terraform plan.')
        booleanParam(name: 'RUN_APPLY', defaultValue: false, description: 'Require approval and apply the reviewed plan. Creates or changes AWS resources.')
    }

    environment {
        AWS_DEFAULT_REGION = 'eu-central-1'
        TF_DIR = 'Module_12_Infrastructure_as_Code_Terraform/Configure_shared_Remote_State'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Format and Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform fmt -check -recursive'
                    sh 'terraform init -backend=false -input=false'
                    sh 'terraform validate -no-color'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression { return params.RUN_PLAN || params.RUN_APPLY }
            }
            steps {
                script {
                    if (!params.STATE_BUCKET.trim()) {
                        error('STATE_BUCKET is required when running a plan or apply.')
                    }
                }
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-terraform-deployer']]) {
                    dir("${TF_DIR}") {
                        sh '''
                            terraform init -input=false -reconfigure \
                              -backend-config="bucket=${STATE_BUCKET}" \
                              -backend-config="key=${STATE_KEY}" \
                              -backend-config="region=${AWS_DEFAULT_REGION}" \
                              -backend-config="encrypt=true" \
                              -backend-config="use_lockfile=true"
                            terraform plan -input=false -out=tfplan
                        '''
                    }
                }
            }
        }

        stage('Approval') {
            when {
                expression { return params.RUN_APPLY }
            }
            steps {
                input message: 'Review the generated Terraform plan. Apply approved changes?', ok: 'Apply'
            }
        }

        stage('Terraform Apply') {
            when {
                expression { return params.RUN_APPLY }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-terraform-deployer']]) {
                    dir("${TF_DIR}") {
                        sh 'terraform apply -input=false tfplan'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${TF_DIR}/tfplan", allowEmptyArchive: true
            cleanWs()
        }
    }
}
