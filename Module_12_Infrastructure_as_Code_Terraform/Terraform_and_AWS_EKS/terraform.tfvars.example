# Copy to terraform.tfvars for local, non-secret development configuration.
# terraform.tfvars is ignored and must never contain AWS credentials.

aws_region         = "eu-central-1"
cluster_name       = "bootcamp-eks-demo"
environment        = "development"
kubernetes_version = "1.31"

availability_zones   = ["eu-central-1a", "eu-central-1b"]
private_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
public_subnet_cidrs  = ["10.30.101.0/24", "10.30.102.0/24"]

node_instance_types   = ["t3.medium"]
endpoint_public_access = false