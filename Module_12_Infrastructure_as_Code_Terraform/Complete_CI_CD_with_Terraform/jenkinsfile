
pipeline{
    stages('Buld Artifact', 'Provision Infrastructure', 'Deploy Application'){
        stage('Build Artifact'){
            steps{
                sh 'mvn clean package'
            }

        }
        stage('Build Docker Image'){
            environment{
                DOCKER_USERNAME = credentials('docker_username')
                DOCKER_PASSWORD = credentials('docker_password')
            }
            steps{
                sh 'docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD'
                sh 'docker build -t myapp:1.0 .'
                sh 'docker push myapp:1.0 '
            }

        }
        stage('Provision Infrastructure'){
            environment{
                AWS_ACCESS_KEY_ID = credentials('jenkins_aws_access_key_id')
                AWS_SECRET_ACCESS_KEY = credentials('jenkins_aws_secret_access_key')
                TF_VAR_env_prefix = 'test' 
            }
            steps{
                sh 'terraform init'
                sh 'terraform apply -auto-approve'
                EC2_PUBLIC_IP = sh(
                    script: "terraform output ec2_public_ip",
                    returnStdout: true
                ).trim()
            }

        }
        stage('Deploy Application'){
            steps(){
                script{
                    echo "EC2 initialized"
                    sleep(time: 90, unit: "SECONDS")

                    def EC2_PUBLIC_IP = ""
                    def shell_cmd = "bash ./server-cmds.sh ${IMAGE_NAME}"
                    def EC2_PUBLIC = "ec2-user@${EC2_PUBLIC_IP}"

                    sshagent(['jenkins_ssh_key']){
                        sh "scp -o StrictHostKeyChecking=no server-cmds.sh ${EC2_PUBLIC}:/home/ec2-user/server-cmds.sh"
                        sh "scp -o StrictHostKeyChecking=no docker-compose.yaml ${EC2_PUBLIC}:/home/ec2-user"
                        sh "ssh -o StrictHostKeyChecking=no ${EC2_PUBLIC} ${shell_cmd}"
                    }
                }
            }
        }
    }
}