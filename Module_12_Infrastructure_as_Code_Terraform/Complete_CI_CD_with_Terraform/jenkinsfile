
pipeline{
    stages(){
        stage(){

        }
        stage(){

        }
        stage('Build Docker Image'){
            steps{
                sh 'docker build -t myapp:1.0 .'
            }

        }
        stage('Provision Infrastructure'){
            environment{
                AWS_ACCESS_KEY_ID = credentials('jenkins_aws_access_key_id')
                AWS_SECRET_ACCESS_KEY = credentials('jenkins_aws_secret_access_key')
                TF_VAR_env_prefix = 'test' 
            }
            steps{
                sh 'terraform init'
                sh 'terraform apply -auto-approve'
                EC2_PUBLIC_IP = sh(
                    script: "terraform output ec2_public_ip",
                    returnStdout: true
                ).trim()
            }

        }
        stage('Deploy Application'){
            steps(){
                script{
                    echo "EC2 initialized"
                    sleep(time: 90, unit: "SECONDS")

                    sshagent(['jenkins_ssh_key']){
                        sh "scp -o StrictHostKeyChecking=no server-cmds.sh ${EC2_PUBLIC_IP}:/home/ec2-user/server-cmds.sh"
                        sh "scp -o StrictHostKeyChecking=no docker-compose.yaml ${EC2_PUBLIC_IP}:/home/ec2-user"
                        sh "ssh -o StrictHostKeyChecking=no ${EC2_PUBLIC_IP} ${shell_cmd}"
                }
            }
        }
    }
}