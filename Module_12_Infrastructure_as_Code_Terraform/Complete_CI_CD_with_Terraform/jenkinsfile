pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'APPLICATION_DIRECTORY', defaultValue: '.', description: 'Repository path containing pom.xml, target/, and Dockerfile.')
        string(name: 'IMAGE_REPOSITORY', defaultValue: '', description: 'Registry repository, for example registry-user/myapp.')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable image tag. Defaults to the Jenkins build number.')
        booleanParam(name: 'RUN_BUILD_AND_PUSH', defaultValue: false, description: 'Build, test, and publish the Java Docker image.')
        booleanParam(name: 'RUN_PLAN', defaultValue: false, description: 'Run an AWS-authenticated Terraform plan.')
        booleanParam(name: 'RUN_APPLY_AND_DEPLOY', defaultValue: false, description: 'Require approval, apply the reviewed plan, and deploy the immutable image.')
    }

    environment {
        TF_DIR = 'Module_12_Infrastructure_as_Code_Terraform/Complete_CI_CD_with_Terraform'
        AWS_DEFAULT_REGION = 'eu-central-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format and Validate') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform fmt -check -recursive'
                    sh 'terraform init -backend=false -input=false'
                    sh 'terraform validate -no-color'
                }
            }
        }

        stage('Build and Test Application') {
            when {
                expression { return params.RUN_BUILD_AND_PUSH }
            }
            steps {
                dir(params.APPLICATION_DIRECTORY) {
                    sh 'test -f pom.xml'
                    sh 'mvn --batch-mode clean verify'
                }
            }
        }

        stage('Build and Publish Image') {
            when {
                expression { return params.RUN_BUILD_AND_PUSH }
            }
            steps {
                script {
                    if (!params.IMAGE_REPOSITORY.trim()) {
                        error('IMAGE_REPOSITORY is required when RUN_BUILD_AND_PUSH is enabled.')
                    }
                    env.RESOLVED_IMAGE_TAG = params.IMAGE_TAG.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER
                    env.APP_IMAGE = "${params.IMAGE_REPOSITORY}:${env.RESOLVED_IMAGE_TAG}"
                }
                dir(params.APPLICATION_DIRECTORY) {
                    withCredentials([usernamePassword(credentialsId: 'container-registry-credentials', usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD')]) {
                        sh '''
                            printf '%s' "$REGISTRY_PASSWORD" | docker login --username "$REGISTRY_USERNAME" --password-stdin
                            docker build --tag "$APP_IMAGE" .
                            docker push "$APP_IMAGE"
                            docker logout
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression { return params.RUN_PLAN || params.RUN_APPLY_AND_DEPLOY }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-terraform-deployer']]) {
                    dir("${TF_DIR}") {
                        sh 'terraform init -input=false -reconfigure'
                        sh 'terraform plan -input=false -out=tfplan'
                    }
                }
            }
        }

        stage('Approval') {
            when {
                expression { return params.RUN_APPLY_AND_DEPLOY }
            }
            steps {
                script {
                    if (!params.RUN_BUILD_AND_PUSH || !env.APP_IMAGE) {
                        error('RUN_APPLY_AND_DEPLOY requires RUN_BUILD_AND_PUSH to publish an immutable APP_IMAGE in this build.')
                    }
                }
                input message: 'Review the Terraform plan and published image. Apply and deploy?', ok: 'Deploy'
            }
        }

        stage('Terraform Apply') {
            when {
                expression { return params.RUN_APPLY_AND_DEPLOY }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-terraform-deployer']]) {
                    dir("${TF_DIR}") {
                        sh 'terraform apply -input=false tfplan'
                        script {
                            env.EC2_PUBLIC_IP = sh(script: 'terraform output -raw ec2_public_ip', returnStdout: true).trim()
                        }
                    }
                }
            }
        }

        stage('Deploy Image') {
            when {
                expression { return params.RUN_APPLY_AND_DEPLOY }
            }
            steps {
                sshagent(credentials: ['jenkins-ec2-deployer']) {
                    sh '''
                        mkdir -p "$HOME/.ssh"
                        ssh-keyscan -H "$EC2_PUBLIC_IP" >> "$HOME/.ssh/known_hosts"
                        scp "$TF_DIR/docker-compose.yaml" "ec2-user@$EC2_PUBLIC_IP:/home/ec2-user/docker-compose.yaml"
                        ssh "ec2-user@$EC2_PUBLIC_IP" \
                          "APP_IMAGE='$APP_IMAGE' APPLICATION_PORT=8080 docker compose -f /home/ec2-user/docker-compose.yaml up -d"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${TF_DIR}/tfplan", allowEmptyArchive: true
        }
    }
}