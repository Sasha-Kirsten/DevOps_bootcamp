pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'BASE_VERSION', defaultValue: '', description: 'Optional MAJOR.MINOR.PATCH override. Leave blank to use VERSION.')
        string(name: 'IMAGE_REPOSITORY', defaultValue: '', description: 'Registry repository, for example docker.io/your-user/simple-maven-app.')
        string(name: 'REGISTRY_HOST', defaultValue: 'docker.io', description: 'Registry hostname used for docker login.')
        booleanParam(name: 'PUBLISH_IMAGE', defaultValue: false, description: 'Push the tested immutable image to the container registry.')
    }

    environment {
        PROJECT_DIRECTORY = 'Module_8_Build_Automation_CI_CD/Dynamically_Increment_Application_version_Jenkins_Pipeline'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Create Build Version') {
            steps {
                script {
                    def helpers = load "${env.PROJECT_DIRECTORY}/CI_step.groovy"
                    def baseVersion = params.BASE_VERSION.trim() ?: readFile("${env.PROJECT_DIRECTORY}/VERSION").trim()
                    env.BUILD_VERSION = helpers.createBuildVersion(baseVersion, env.BUILD_NUMBER)
                }
                echo "Immutable build version: ${env.BUILD_VERSION}"
            }
        }

        stage('Build and Test') {
            steps {
                script{
                    def helpers = load "${env.PROJECT_DIRECTORY}/CI_step.groovy"
                    helpers.mavenVerify(env.PROJECT_DIRECTORY)
                }
            }
        }

        stage('Build Image') {
            steps {
                dir(env.PROJECT_DIRECTORY) {
                    script {
                        def helpers = load 'CI_step.groovy'
                        helpers.buildDockerImage('simple-maven-app', env.BUILD_VERSION)
                    }
                }
            }
        }

        stage('Publish Image') {
            when {
                expression { return params.PUBLISH_IMAGE }
            }
            steps {
                script {
                    if (!params.IMAGE_REPOSITORY.trim()) {
                        error('IMAGE_REPOSITORY is required when PUBLISH_IMAGE is enabled.')
                    }
                    env.PUBLISHED_IMAGE = "${params.IMAGE_REPOSITORY}:${env.BUILD_VERSION}"
                }
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh '''
                        printf '%s' "$REGISTRY_PASSWORD" | docker login "$REGISTRY_HOST" --username "$REGISTRY_USERNAME" --password-stdin
                        docker image tag "simple-maven-app:$BUILD_VERSION" "$PUBLISHED_IMAGE"
                        docker image push "$PUBLISHED_IMAGE"
                        docker logout "$REGISTRY_HOST"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${env.PROJECT_DIRECTORY}/target/*.jar", allowEmptyArchive: true
            junit testResults: "${env.PROJECT_DIRECTORY}/target/surefire-reports/*.xml", allowEmptyResults: true
        }
    }
}